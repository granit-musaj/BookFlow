# --- Database (Docker service hostname is "postgres") ---
# Local (backend jashtë Docker): postgresql://bookflow:bookflow@localhost:5432/bookflow
DATABASE_URL=postgresql://bookflow:bookflow@postgres:5432/bookflow

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
# Në prod: string i rastësishëm i gjatë (p.sh. openssl rand -base64 64)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Refresh cookie (defaults: SameSite=Lax, Secure in production, path=/api/auth)
# Recommended production: app.example.com + api.example.com (same-site) so Lax works.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# COOKIE_PATH=/api/auth

# --- Seed (npm run db:seed) — passwords required, never hardcoded ---
# SEED_OWNER_EMAIL=owner@studio.com
# SEED_STAFF_EMAIL=staff@studio.com
# SEED_CLIENT_EMAIL=client@email.com
# SEED_BUSINESS_NAME=Studio Aureel
# SEED_BUSINESS_SLUG=studio-aureel
# SEED_OWNER_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_CLIENT_PASSWORD=

# --- AI assistant (optional) ---
# Nëse mungon, backend-i niset normalisht; POST /api/public/businesses/:slug/assistant kthen 503.
# ANTHROPIC_API_KEY=
