# Public site origin used for absolute Open Graph / Twitter image URLs.
# In Vercel: Settings → Environment Variables → VITE_SITE_URL
# Example: https://bookflow.example.com
VITE_SITE_URL=http://localhost:5173

# Local: /api is proxied by Vite to http://localhost:3000 so the refresh
# cookie is first-party (SameSite=Lax works after a hard reload).
# Production: set the public API origin, e.g. https://api.example.com/api
VITE_API_URL=/api
